# Copy to .env and fill in. Never commit .env.
BASETEN_API_KEY=
ASR_MODEL_URL=
ASR_STOCK_MODEL_URL=
# 1 = run a local stock Whisper beside the deployed tuned one, for the stock-vs-tuned toggle
ASR_STOCK_LOCAL=
# Beam width for the deployed Whisper: 1 fastest, 3 default, 5 slowest (about 1.7 s)
ASR_BEAM_SIZE=3
# The controller's own voice: one beam (0.3 s), one 3.5 s attempt, then the local model hears it.
ASR_CONTROLLER_BEAM=1
ASR_CONTROLLER_TIMEOUT_S=3.5
# Seconds between keep-warm calls to the deployed model while voice is on and a screen is connected. 0 = off.
ASR_KEEP_WARM_S=240
CHECKER_MODEL_URL=
EXTRACTOR_MODEL=
RESOLVER_MODEL=
# The conversational agent (squack, the command bar) only: everything else stays on Baseten.
# Without these it falls back to Baseten, and without a Baseten key to the keyword router.
OPENAI_API_KEY=
SQUACK_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=
